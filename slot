#!/usr/bin/env python3
import random
import time
import os

def clear_screen():
    os.system('cls' if os.name == 'nt' else 'clear')


def play_slot(money, times_gambled):
    playing = True
    while playing and money > 0:
        clear_screen()
        jackpot_extra = 0
        random_number = [random.randint(1, 9), random.randint(1, 9), random.randint(1, 9)]
        print(f"Current money: {money:.2f} | times gambled: {times_gambled}")
        try:
            bet_money = float(input("How much do you want to bet? "))
        except ValueError:
            print("Are you a retard? Enter a number.")
            print(f"Current money: {money}")
            continue
        clear_screen()
        if bet_money > money:
            print("Broke boy")
            print(f"Current money: {money}")
            continue
        money = money - bet_money

        print("Spinning...")
        time.sleep(0.5)
        for i in range(5):
            time.sleep(0.1)
            clear_screen()
            print(f"{random.randint(1, 9)} | {random.randint(1, 9)} | {random.randint(1, 9)}")
        for i in range(5):
            time.sleep(0.1)
            clear_screen()
            print(f"{random_number[0]} | {random.randint(1, 9)} | {random.randint(1, 9)}")
        if random_number[0] == random_number [1]:
            for i in range(15):
                time.sleep(0.1)
                clear_screen()
                print(f"{random_number[0]} | {random_number[1]} | {random.randint(1, 9)}")
        else:
            for i in range(5):
                time.sleep(0.1)
                clear_screen()
                print(f"{random_number[0]} | {random_number[1]} | {random.randint(1, 9)}")
        clear_screen()
        print(f"{random_number[0]} | {random_number[1]} | {random_number[2]}")

        if random_number[0] == random_number[1] == random_number[2] == 7:
            bet_money = bet_money * 50 + jackpot_extra
            jackpot_extra = 0
            print("***************************")
            print("      !!! JACKPOT !!!")
            print("***************************")
        elif random_number[0] == random_number[1] == random_number[2]:
            bet_money = bet_money * 10 + jackpot_extra
            jackpot_extra = 0
            print("***************************")
            print("   !!! SMALL JACKPOT !!!")
            print("***************************")
        elif random_number[0] == random_number[1] or random_number[0] == random_number[2] or random_number[1] == random_number[2]: 
            bet_money = bet_money * 1.5
            print("***************************")
            print("       !!! PAIR !!!")
            print("***************************")
        elif random_number[0] + 1 == random_number[1] and random_number[1] + 1 == random_number[2]:
            bet_money = bet_money * 3
            print("***************************")
            print("     !!! STRAIGHT !!!")
            print("***************************")
        elif random_number[0] == random_number[1] + 1 and random_number[1] == random_number[2] + 1:
            bet_money = bet_money * 2
            print("***************************")
            print(" !!! REVERSE STRAIGHT !!!")
            print("***************************")
        else:
            jackpot_extra += bet_money / 2
            bet_money = 0
            print("***************************")
            print("     !!! YOU LOSE !!!")
            print("***************************")
        print(f"You won: {bet_money}")
        
        action = input("Spin again? (y/n): ").lower()
        if action in ["n", "no"]:
            playing = False
        times_gambled += 1
        money += bet_money
    return money, times_gambled
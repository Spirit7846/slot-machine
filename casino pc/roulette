#!/usr/bin/env python3
import random
import time
import os

def clear_screen():
    os.system('cls' if os.name == 'nt' else 'clear')

def play_roulette(money, times_gambled):
    playing = True
    while playing and money > 0:
        clear_screen()
        roulette_number = random.randint(0, 36)
        print(f"Current money: {money:.2f} | times gambled: {times_gambled}")
        print("(1)red / (2)black / (3)odd / (4)even \n(5)range1-18 / (6)range19-36 / (7)numbers")
        bet = input("what you wanna bet on?: ")
        bet_money = float(input("how much you wanna bet?: "))
        money = money - bet_money

        red = 1, 3, 5, 7, 9, 12, 14, 16, 18, 19, 21, 23, 25, 27, 30, 32, 34, 36
        black = 2, 4, 6, 8, 10, 11, 13, 15, 17, 20, 22, 24, 26, 28, 29, 31, 33, 35

        if bet == "black" or bet == "2":
            if roulette_number in black:
                bet_money *= 2
            else:
                bet_money = 0
        elif bet == "red" or bet == "1":
            if roulette_number in red:
                bet_money *= 2
            else:
                bet_money = 0
        elif bet == "odd" or bet == "3":
            if roulette_number // 2 * 2 == roulette_number and roulette_number != 0:
                bet_money = 0
            else:
                bet_money *= 2
        elif bet == "even" or bet == "4":
            if roulette_number // 2 * 2 == roulette_number and roulette_number != 0:
                bet_money *= 2
            else:
                bet_money = 0
        elif bet == "range1-18" or bet == "5":
            if roulette_number >= 1 and roulette_number <= 18:
                bet_money *= 2
            else:
                bet_money = 0
        elif bet == "range19-36" or bet == "6":
            if roulette_number >= 19 and roulette_number <= 36:
                bet_money *= 2
            else:
                bet_money = 0
        elif bet == "numbers" or bet == "7":
            clear_screen()
            print("between 0-36")
            number = int(input("what number you wanna bet on?:"))
            if number >= 0 or number <= 36:
                if number == roulette_number:
                    bet_money *= 36
                else:
                    bet_money = 0
            else:
                print("not a valid bet")
                continue
        else:
            print("not a valid bet")
            continue

        clear_screen()
        print("Spinning...")
        time.sleep(0.5)
        for i in range(25):
            time.sleep(0.1)
            clear_screen()
            print(f"{random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)}")
        for i in range(10):
            time.sleep(0.2)
            clear_screen()
            print(f"{random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)}")
        for i in range(5):
            time.sleep(0.4)
            clear_screen()
            print(f"{random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)}")
        clear_screen()
        print(f"{roulette_number} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)} | {random.randint(0, 36)}")
        time.sleep(1)
        clear_screen()
        print(f"{roulette_number}")
        print(f"You won: {bet_money}")

        action = input("Spin again? (y/n): ").lower()
        if action in ["n", "no"]:
            playing = False
        times_gambled += 1
        money = money + bet_money
    return money, times_gambled